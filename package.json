  "scripts": {
    "prestart": "npm install",
    "start": "http-server . -a localhost -p 8080 -c-1",
    "gulp": "gulp",
    "start-built": "http-server build -a localhost -p 8081 -c-1",
    "gulp-dev": "gulp --dev",
    "build": "gulp optimize",
    "watch-css": "gulp sass-watcher",
    "test": "karma start karma.conf.js --single-run",
    "test-single": "karma start karma.conf.js --single-run",
    "inspect-sheets": "node scripts/inspect-sheets.mjs",
    "reconcile": "node scripts/reconcile.mjs",
    "build-db": "node --no-warnings scripts/build-db.mjs",
    "data": "npm run reconcile && npm run build-db && npm run verify",
    "watch-html": "nodemon -e html -x \"gulp template-cache\"",
    "test-scripts": "node --test \"scripts/lib/*.test.mjs\"",
    "verify": "node --no-warnings scripts/verify.mjs",
    "check": "npm run test-scripts && npm run test-single && npm run verify",
    "dev:vue": "vite app/vue",
    "build:vue": "vite build app/vue",
    "preview:vue": "vite preview app/vue",
    "test:vue": "vitest run",
    "test:vue:watch": "vitest",
    "type-check": "tsc --noEmit"
