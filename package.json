{
  "name": "5e-monsters",
  "version": "2.0.0",
  "description": "Kobold Fight Club v2 - D&D 5e Encounter Builder and Battle Tracker",
  "main": "app/vue/index.html",
  "type": "module",
  "dependencies": {
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/server-renderer": "^3.5.42",
    "esbuild": "0.28.2",
    "gulp": "^5.0.1",
    "vite": "8.2.2",
    "vue": "3.5.41",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@vue/test-utils": "^2.5.0",
    "http-server": "^14.1.1",
    "jsdom": "^24.1.3",
    "nodemon": "^3.1.14",
    "sass": "^1.103.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "prestart": "npm install",
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "reconcile": "node scripts/reconcile.mjs",
    "build-db": "node --no-warnings scripts/build-db.mjs",
    "verify": "node --no-warnings scripts/verify.mjs",
    "data": "npm run reconcile && npm run build-db && npm run verify",
    "test-scripts": "node --test \"scripts/lib/*.test.mjs\"",
    "check": "npm run test-scripts && npm run test && npm run verify"
  },
  "repository": {
    "type": "git",
    "url": "git+  https://github.com/strider-ops/kobold-fight-club.git"
  },
  "author": "tistrider",
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true
  }
}
