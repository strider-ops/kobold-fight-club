{
  "name": "5e-monsters",
  "version": "2.1.0",
  "description": "Kobold Fight Club v2 - D&D 5e Encounter Builder and Battle Tracker",
  "main": "app/vue/index.html",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "prestart": "npm install",
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "reconcile": "node scripts/reconcile.mjs",
    "build-db": "node --no-warnings scripts/build-db.mjs",
    "verify": "node --no-warnings scripts/verify.mjs",
    "data": "npm run reconcile && npm run build-db && npm run verify",
    "test-scripts": "node --test \"scripts/lib/*.test.mjs\"",
    "check": "npm run test-scripts && npm run test && npm run verify"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "vite": "8.3.4",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "sass": "1.105.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "vue-eslint-parser": "10.4.1"
  },
  "repository": {
    "type": "git",
    "url": "git+  https://github.com/strider-ops/kobold-fight-club.git"
  },
  "author": "tistrider",
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "fsevents@2.3.3": true
  }
}
